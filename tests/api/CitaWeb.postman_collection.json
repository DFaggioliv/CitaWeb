{
  "info": {
    "name": "CitaWeb - Fase 2 - API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "23 solicitudes encadenadas con aserciones HTTP, esquema y contenido. Usar solo en QA aislado; crea cuentas y citas de prueba."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runEmail')) {",
          " const date = new Date(Date.now() - 6*60*60*1000);",
          " date.setUTCDate(date.getUTCDate()+1);",
          " while ([0,6].includes(date.getUTCDay())) date.setUTCDate(date.getUTCDate()+1);",
          " pm.collectionVariables.set('testDate',date.toISOString().slice(0,10));",
          " pm.collectionVariables.set('runEmail',`qa-${Date.now()}@example.invalid`);",
          " pm.collectionVariables.set('runPassword','QA-only-password-2026');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Salud del servicio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Esquema de respuesta', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"ok\", \"service\"], \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"service\": {\"type\": \"string\"}}}));",
              "const responseBody = pm.response.json();",
              "pm.test('Contenido de negocio esperado', () => { pm.expect(responseBody.ok).to.equal(true); pm.expect(responseBody.service).to.equal('CitaWeb API'); });",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Registro válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Usuario API QA\", \"email\": \"{{runEmail}}\", \"password\": \"{{runPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test('Código HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Esquema de respuesta', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"token\", \"user\"], \"properties\": {\"token\": {\"type\": \"string\", \"minLength\": 1}, \"user\": {\"type\": \"object\", \"required\": [\"id\", \"name\", \"email\", \"role\"]}}}));",
              "const responseBody = pm.response.json();",
              "pm.test('Contenido de negocio esperado', () => { pm.expect(responseBody.user.email).to.equal(pm.collectionVariables.get('runEmail')); pm.expect(responseBody.user.role).to.equal('user'); });",
              "pm.collectionVariables.set('userToken', responseBody.token); pm.collectionVariables.set('userId', responseBody.user.id);",
              "})();"
            ]
          }
        }
      ]
    },
